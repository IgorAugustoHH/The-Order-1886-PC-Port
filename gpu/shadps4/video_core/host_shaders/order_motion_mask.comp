// bbport (The Order: 1886): reactive mask for the output upscaler, which runs on the finished
// frame, after the game's motion blur. Around a velocity discontinuity (a character moving
// over the background) the blur smears one surface over the other, where the motion vectors
// say otherwise: the history there would leave trails. Where a nearby pixel moves relative to
// this one by at least about its distance, the upscaler relies on the current frame (already
// blurred there); camera motion alone (no relative motion) keeps the history.
#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rg16f) uniform readonly image2D motion; // render pixels
layout(binding = 1) uniform writeonly image2D mask;         // R8

layout(push_constant) uniform Params {
    float strength; // the mask's maximum (at most 1)
};

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(motion);
    if (any(greaterThanEqual(p, size))) {
        return;
    }
    const vec2 v0 = imageLoad(motion, p).xy;
    const vec2 dirs[8] = vec2[](vec2(1.0, 0.0), vec2(0.7071, 0.7071), vec2(0.0, 1.0),
                                vec2(-0.7071, 0.7071), vec2(-1.0, 0.0), vec2(-0.7071, -0.7071),
                                vec2(0.0, -1.0), vec2(0.7071, -0.7071));
    const float radii[5] = float[](1.5, 4.0, 9.0, 18.0, 36.0);
    float value = 0.0;
    for (int r = 0; r < 5; ++r) {
        for (int d = 0; d < 8; ++d) {
            const ivec2 q = clamp(p + ivec2(round(dirs[d] * radii[r])), ivec2(0), size - 1);
            const float relative = length(imageLoad(motion, q).xy - v0);
            // The blur of the faster surface reaches about its relative speed in pixels.
            if (relative >= 0.5 * radii[r]) {
                value = max(value, smoothstep(1.0, 4.0, relative));
            }
        }
    }
    imageStore(mask, p, vec4(value * strength));
}
